# Copy to .env (cp .env.example .env) and edit. .env is not committed.

# UID:GID of the owner of ./data (Linux: stat -c '%u:%g' data). Default 1000:1000.
# Not needed to match on Docker Desktop (Windows/macOS), but keep the defaults there.
VAULT_UID=1000
VAULT_GID=1000

# Time zone for the container (logs, activity log).
TZ=UTC

# Optional. Protects the very first registration (creating the administrator).
# Generate: openssl rand -hex 16
# After editing run: docker compose up -d
# Check: curl http://127.0.0.1:8585/api/status  -> "setup_token_required": true
SETUP_TOKEN=

# Optional. Comma-separated addresses or subnets whose X-Forwarded-For is trusted,
# or "none" to ignore the header. Empty = loopback and private ranges (fits a proxy on the same host).
TRUSTED_PROXIES=
